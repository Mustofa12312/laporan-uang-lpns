rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Transactions collection rules
    match /transactions/{transactionId} {
      // Anyone logged in can read (Admin, Ketua, Sekretaris, Bendahara)
      allow read: if isAuthenticated();
      
      // Only Admin, Sekretaris, Bendahara can create/update
      allow create, update: if isAuthenticated() && 
        (getUserRole() == 'ADMIN' || getUserRole() == 'SEKRETARIS' || getUserRole() == 'BENDAHARA');
      
      // Soft Delete: actual document deletion only by Admin
      allow delete: if isAuthenticated() && getUserRole() == 'ADMIN';
    }

    // Users collection rules
    match /users/{userId} {
      // Anyone logged in can read basic profiles
      allow read: if isAuthenticated();
      
      // Users can create their own profile document (for initial setup)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Only Admin can create/update/delete other users
      allow create, update, delete: if isAuthenticated() && getUserRole() == 'ADMIN';
      
      // Users can update their own profile (except role)
      allow update: if isAuthenticated() && request.auth.uid == userId 
                    && request.resource.data.role == resource.data.role; // prevent role escalation
    }

    // Settings collection rules
    match /settings/{document=**} {
      // Read access to all authenticated users
      allow read: if isAuthenticated();
      // Write access only to Admin
      allow write: if isAuthenticated() && getUserRole() == 'ADMIN';
    }
  }
}
